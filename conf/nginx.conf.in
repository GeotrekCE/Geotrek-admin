upstream ui_server {
    server unix:/tmp/gunicorn-geotrek.sock fail_timeout=0;
}

upstream api_server {
    server unix:/tmp/gunicorn-geotrek_api.sock fail_timeout=0;
}

map ${DOLLAR}uri ${DOLLAR}pdf_limit_key {
    default "";
    ~*\.pdf${DOLLAR} ${DOLLAR}server_name;
}
limit_conn_zone ${DOLLAR}pdf_limit_key zone=pdf_concurrency:10m;

map ${DOLLAR}http_origin ${DOLLAR}allow_origin {
    "~${RANDO_SERVER_NAME_PIPE}" ${DOLLAR}http_origin;
    default "";
}

map $http_user_agent $is_indexer {
    default 0;
    ~*(bot|crawler|spider|slurp|meta-externalagent|meta-webindexer|facebookexternalhit|Bytespider|Amazonbot|RiverBot|Brightbot|PetalBot|DotBot|MJ12bot|SemrushBot|AhrefsBot|Baiduspider|GoogleOther|GiantCrawler|SeznamBot|ia_archiver|GoogleBot) 1;
}

server {
    listen ${NGINX_PORT};
    server_name ${SERVER_NAME};
    server_name_in_redirect on;
    server_tokens off;
    gzip             on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level  4;
    gzip_types       application/json application/geo+json;

    access_log /var/log/nginx/geotrek_access.log;
    error_log /var/log/nginx/geotrek_error.log;

    client_max_body_size 200M;

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nAllow: /media/\nDisallow: /\n";
    }

    location /static {
        expires 1d;
        alias /opt/geotrek-admin/var/static;
        add_header Access-Control-Allow-Origin ${DOLLAR}allow_origin;
    }

    location ~ ^/mobile/(.*)$ {
        if ($is_indexer) {
            return 403;
        }

        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Vary "Accept-Language";
	    add_header Access-Control-Allow-Origin "*";
        add_header Access-Control-Allow-Methods "GET, OPTIONS";
        root /opt/geotrek-admin/var/mobile/;
        try_files /${DOLLAR}http_accept_language/$1 /nolang/$1 =404;
        gzip on;
        gzip_types text/text text/plain text/xml text/css application/x-javascript application/javascript application/json;
        include mime.types;
        types {
            application/json geojson;
            application/gpx+xml gpx;
            application/x-font-ttf ttf;
        }
    }

    location /media {
        expires 1d;
        alias /opt/geotrek-admin/var/media ;
        add_header Access-Control-Allow-Origin ${DOLLAR}allow_origin;
    }

    location /media_secure {
        internal;
        expires 1d;
        alias /opt/geotrek-admin/var/media;
    }

    location ~ ^/m/(?<remaining_path>.*)$ {
        root /;
        try_files /opt/geotrek-admin/var/frontend/dist/${DOLLAR}remaining_path /opt/geotrek-admin/var/frontend/dist/index.html =404;
    }

    location ^~ /m/sw.js {
        alias /opt/geotrek-admin/var/frontend/dist/sw.js;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        expires off;
        access_log off;
    }

    location = /m {
        return 307 /m/;
    }

    location ~* ^/api/.*\.(pdf|kml|gpx)${DOLLAR} {
        if (${DOLLAR}is_indexer) { return 403; }

        limit_conn pdf_concurrency 2;
        limit_conn_status 503;

        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Access-Control-Allow-Origin ${DOLLAR}allow_origin always;

        proxy_read_timeout 120s;
        proxy_pass http://api_server;
    }

    location / {
        if ($is_indexer) {
            return 403;
        }

        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header X-Forwarded-Host ${DOLLAR}host;
        proxy_set_header X-Forwarded-Server ${DOLLAR}host;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;

        proxy_set_header Host ${DOLLAR}http_host;
        proxy_redirect off;

        keepalive_timeout 0;

        location ~ ^/api {
            proxy_pass http://api_server;
            proxy_read_timeout ${TIMEOUT}s;
            add_header Access-Control-Allow-Origin ${DOLLAR}allow_origin always;
        }

        proxy_pass http://ui_server;
        proxy_read_timeout ${TIMEOUT}s;
    }
}
